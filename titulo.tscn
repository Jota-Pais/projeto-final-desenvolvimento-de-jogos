[node name="Texto" type="Label" parent="Conteudo/ComoSeJoga"]
layout_mode = 2
theme_override_colors/font_color = Color(0.847059, 0.796078, 0.713725, 1)
theme_override_font_sizes/font_size = 15
text = "WASD ou setas — andar     ·     Shift — correr     ·     E (segurar) — vasculhar, entrar em casa
mouse — mirar     ·     botão esquerdo — atirar     ·     Tab — mochila     ·     Q — trocar de arma

O dia começa com você na calçada, em frente à sua casa, e tem 420 segundos de luz.
Vasculhar gasta luz em dobro. Volte à porta antes de anoitecer e segure E nela:
só entra em casa o que passou por ali. A cura precisa de 4 documentos e o prazo é de 30 dias.
Dentro de casa é só mouse: o que dá para usar acende quando o mouse passa.
As bolinhas do canto são a energia da noite. A cama encerra a noite."
horizontal_alignment = 1
autowrap_mode = 3

